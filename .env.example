# ============================================================================
# SentinelQA — Environment Variables
# Copy this file to .env and fill in the values.
# ============================================================================

# ── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=   # Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/sentinelqa
# If using Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/sentinelqa

# ── GitHub OAuth (for dashboard login) ───────────────────────────────────────
GITHUB_ID=
GITHUB_SECRET=

# ── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_ID=
GOOGLE_SECRET=

# ── GitLab OAuth ─────────────────────────────────────────────────────────────
GITLAB_ID=
GITLAB_SECRET=

# ── GitHub MCP — Personal Access Token (repo scope) ─────────────────────────
GITHUB_PERSONAL_ACCESS_TOKEN=

# ── AI Engine (Aaskar's LangGraph service) ───────────────────────────────────
# URL to connect to AI Engine (leave empty for mock mode)
# Docker: http://ai-engine:5000
# Local dev: http://localhost:8000 (or 5000 if AirPlay is disabled on macOS)
AI_ENGINE_URL=http://localhost:8000

# LLM Provider: openai | anthropic | groq
LLM_PROVIDER=openai

# OpenAI (recommended for cost-effective testing)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (alternative)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Groq (fastest alternative)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Slack Notifications ──────────────────────────────────────────────────────
# Incoming Webhook URL for the #sentinelqa channel.
# Create at: https://api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=

# ── Optional: Default repo for MCP health check ─────────────────────────────
SENTINELQA_DEFAULT_OWNER=Arpit529Srivastava
SENTINELQA_DEFAULT_REPO=Hack-karo
SENTINELQA_DEFAULT_BRANCH=main
